# Copy this file to .env and fill in real values. .env is git-ignored.
# Resolution order: real environment variable > .env > default in application.yaml.
# Values are parsed as Java properties: KEY=value on one line, unquoted; # starts a comment.

# Required: NVIDIA NIM API key (https://build.nvidia.com/settings). App fails fast at startup if blank.
NVIDIA_API_KEY=your-nvidia-api-key-here

# Required: absolute or relative path to your Obsidian vault root.
OBSIDIAN_VAULT_PATH=D:/Notes/MyVault

# Optional: pgvector Postgres connection (defaults shown; note the non-default port 5433).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=obsidian_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
